#pragma once

// --- WiFi (2.4 GHz network - ESP32 cannot see 5 GHz networks) ---
#define WIFI_SSID      "YOUR_WIFI_NAME"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// --- Bambu Lab printer (Settings > Network on the printer) ---
#define PRINTER_IP     "192.168.1.100"
#define PRINTER_SN     "01P00A000000000"      // serial number, same screen
#define PRINTER_LAN_CODE  "12345678"           // 8-char LAN Access Code
